LOG_LEVEL=DEBUG
PORT=8080
# The payer-facing origin. Its host is the LNURL domain Lite signs and publishes.
BASE_URL=http://localhost:8080
DATABASE_URL=postgresql://myuser:mypass@localhost:5432/alby_lite
# generate using deno task db:generate:key
ENCRYPTION_KEY=
NOSTR_NIP57_PRIVATE_KEY=
# Shared with the app: authorizes /users writes. Generate with: openssl rand -hex 32
TRAVELSATS_REGISTRATION_SECRET=
# Browser origins allowed to call /lnurlpay/* (comma-separated). Defaults to the BASE_URL origin.
APP_ORIGINS=
# Spark minter (optional locally; all three are needed to mint Spark invoices)
BREEZ_API_KEY=
SPARK_MINTER_MNEMONIC=
SPARK_WEBHOOK_SECRET=
# Absolute webhook URL registered with the minter. Defaults to ${BASE_URL}/spark/webhook.
SPARK_WEBHOOK_URL=
# Optional: minter storage connection string. Default: DATABASE_URL with the breez_minter schema.
SPARK_MINTER_DATABASE_URL=
# Disposable Postgres for `deno task test:integration` (never a real database)
LITE_TEST_DATABASE_URL=
